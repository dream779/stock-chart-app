# Anthropic-compatible base URL for MiniMax
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic

# MiniMax API key (server-side only; never expose to the browser)
ANTHROPIC_API_KEY=<your-minimax-api-key>

# Bearer token for Vercel Cron to call /api/cron/daily-summarize
CRON_SECRET=replace-with-a-random-string

# Tavily Search API key (free tier 1000 req/month) for fund news
# Get one at https://tavily.com — missing key silently skips news, summary still runs
TAVILY_API_KEY=tvly-your-key-here